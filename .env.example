# 你的 Telegram Bot Token (从 @BotFather 获取)
BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# 管理员的 Telegram 数字 ID (从 @userinfobot 获取)
ADMIN_ID=123456789

# (可选) 代理配置，支持 HTTP/HTTPS/SOCKS5
# 例如: http://127.0.0.1:7890 或 socks5://127.0.0.1:7890
# 注意：Docker 容器内填 127.0.0.1 会指向容器自身，需改用宿主机地址
#   - Docker Desktop(Win/Mac): http://host.docker.internal:7890
#   - Linux: 填宿主机局域网 IP，如 http://192.168.x.x:7890
PROXY_URL=